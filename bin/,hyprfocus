#!/usr/bin/env python3
""",hyprfocus — inspect and explain the hyprfocus declaration.

A mode declares a desk; the system converges on it. This is the command-line
way in, and it is Python rather than shell because the declaration is JSON and
resolving it is set arithmetic.

It deliberately works with no compositor and no shell running: the declaration
is a file, and answering "what does study mode mean" should not depend on the
thing it configures being up. That is also why the read-only verbs are useful
on their own — `plan` tells you what a transition would take away before you
enter it.

  ,hyprfocus resolve <mode>   the complete desk that mode means
  ,hyprfocus plan <mode>      what would change from the mode running now
  ,hyprfocus explain          which mode is on, who set it, and when
  ,hyprfocus modes            every user-facing mode (hidden ones omitted)
  ,hyprfocus seed <file>      install a declaration into the store
  ,hyprfocus apply <mode>     bring background work in line with a mode
  ,hyprfocus log              recent scene-policy rows (background work)
  ,hyprfocus log --trace <address> [--follow]
                              the window lifecycle journal (LEO-352), filtered
                              by window address; wraps `journalctl --user -t
                              hyprfocus -o json`

`apply` covers background work only. Workspaces, binding trees and window
geometry belong to the compositor, which acts on the same declaration from its
own side; this half can run with no compositor at all, which is the point.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

# Delta-grammar kinds. Scenes are listed per mode outright; the mode's
# workspaces are derived from its scene set.
KINDS = ("bindings", "services", "projects")
REF_KIND = {
    "scene": "scenes",
    "binding": "bindings",
    "service": "services",
    "project": "projects",
}
KIND_REF = {plural: singular for singular, plural in REF_KIND.items()}
# Host monitor roles a scene placement may name (conf/hosts/*.lua).
MONITOR_ROLES = ("primary", "secondary")


def state_dir() -> Path:
    """The shared quantum-store directory (QF_STORE), legacy as the read-back."""
    if os.environ.get("QF_STORE"):
        return Path(os.environ["QF_STORE"])
    return (
        Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
        / "quantum-store"
    )


def legacy_state_dir() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))


def read_store(name: str) -> dict | None:
    """Read a store file forward-first, legacy as the migration step back."""
    for base in (state_dir(), legacy_state_dir()):
        target = base / name
        if target.exists():
            return json.loads(target.read_text())
    return None


def load(path: Path | None) -> dict:
    if path:
        return json.loads(path.read_text())
    existing = read_store("hyprfocus.json")
    if existing is not None:
        return existing
    sys.exit(f"no declaration at {state_dir() / 'hyprfocus.json'}")


def apply_delta(base: list[str], delta: dict | None, where: str) -> list[str]:
    """One kind's delta against the base, preserving declaration order.

    Deltas are a writing convenience with no runtime existence: everything acts
    on the resolved desk, never on a delta, so a mode always means the same
    thing however it was reached.
    """
    if not delta:
        return list(base)
    if "only" in delta and ("add" in delta or "remove" in delta):
        sys.exit(f"{where}: `only` cannot be combined with `add` or `remove`")
    if "only" in delta:
        return list(delta["only"])

    removed = set(delta.get("remove", []))
    out = [name for name in base if name not in removed]
    for name in delta.get("add", []):
        if name not in out:
            out.append(name)
    return out


def close_deps(desk: dict, base: dict, mode: str, removed: dict[str, set[str]]) -> None:
    """Pull in what the admitted resources imply, transitively.

    Two strengths, mirroring systemd rather than inventing a vocabulary:
    `requires` cannot function without it, so a mode that removes one is a
    conflict; `wants` merely uses it, so a mode that removes one wins silently.
    """
    graphs = {"requires": base.get("requires", {}), "wants": base.get("wants", {})}
    present = {kind: set(desk[kind]) for kind in KINDS}
    queue = [f"scene:{name}" for name in desk["workspaces"]]
    queue += [f"{KIND_REF[kind]}:{name}" for kind in KINDS for name in desk[kind]]
    seen: set[str] = set()

    while queue:
        key = queue.pop(0)
        if key in seen:
            continue
        seen.add(key)
        for strength, graph in graphs.items():
            for ref in graph.get(key, []):
                singular, _, name = ref.partition(":")
                kind = REF_KIND.get(singular)
                if not kind:
                    sys.exit(
                        f"mode '{mode}': malformed {strength} reference '{ref}' on {key}"
                    )
                if kind == "scenes":
                    # Checked, never added: scene sets are explicit.
                    if strength == "requires" and name not in desk["workspaces"]:
                        sys.exit(
                            f"scene_required: mode '{mode}': scene '{name}' is required by {key} but not in the mode's scene set"
                        )
                    continue
                if name in removed[kind]:
                    if strength == "requires":
                        sys.exit(
                            f"mode '{mode}': {kind} '{name}' is removed but required by {key}"
                        )
                    continue
                if name not in present[kind]:
                    present[kind].add(name)
                    desk[kind].append(name)
                    queue.append(ref)


def refusal(mode: str, token: str, detail: str, **extra) -> dict:
    """A mode-validation refusal record; `reason` leads with the token."""
    return {
        "stage": "admit",
        "event": "mode_refused",
        "decision": "refuse",
        "mode": mode,
        "refusal": token,
        "reason": f"{token}: mode '{mode}': {detail}",
        **extra,
    }


def validate(declaration: dict, mode: str) -> dict | None:
    """Refuse a malformed scene set before resolving; mirrors resolve.lua.

    Claims are block `classes` strings compared textually; `barred` and
    `spawn.class` are not claims.
    """
    spec = declaration.get("modes", {}).get(mode)
    if spec is None:
        return refusal(mode, "unknown_mode", "not declared")
    if not isinstance(spec.get("scenes"), list):
        return refusal(
            mode, "missing_scenes", "no `scenes` list (a pre-v3 declaration?)"
        )
    if mode == "neutral" and spec.get("hidden") is not True:
        return refusal(
            mode,
            "hidden_required",
            "neutral is the recovery fallback and must be hidden",
        )
    catalog = declaration.get("base", {}).get("scenes", {})
    drawers = declaration.get("base", {}).get("drawers", {})

    # Drawer keys are checked once per call, independent of the mode: one
    # key per drawer everywhere (LEO-363), so two catalog entries sharing a
    # key is a declaration error before any scene set is even considered —
    # the same footing as a class two active scenes both claim.
    drawer_key_owner: dict[str, str] = {}
    for drawer_id, drawer in drawers.items():
        key = drawer.get("key")
        owner = drawer_key_owner.get(key)
        if owner and owner != drawer_id:
            return refusal(
                mode,
                "drawer_key_conflict",
                f"drawer key '{key}' claimed by {owner} and {drawer_id}",
                key=key,
                drawers=[owner, drawer_id],
            )
        drawer_key_owner[key] = drawer_id

    listed: set[str] = set()
    claimed_by: dict[str, str] = {}
    for placement in spec["scenes"]:
        name = placement.get("name")
        if name not in catalog:
            return refusal(
                mode, "unknown_scene", f"scene '{name}' is not in base.scenes"
            )
        monitor = placement.get("monitor")
        if monitor not in MONITOR_ROLES:
            return refusal(
                mode,
                "unknown_monitor",
                f"scene '{name}' names monitor '{monitor}', not a host role",
                scenes=[name],
            )
        if name in listed:
            return refusal(
                mode,
                "duplicate_scene",
                f"scene '{name}' is listed twice",
                scenes=[name],
            )
        listed.add(name)
        for drawer_id in catalog[name].get("drawers", []):
            if drawer_id not in drawers:
                return refusal(
                    mode,
                    "unknown_drawer",
                    f"scene '{name}' assigns unknown drawer '{drawer_id}'",
                    scenes=[name],
                )
        for block in catalog[name].get("blocks", []):
            for cls in block.get("classes", []):
                # A slot-bearing block (LEO-364) claims the launch-identity tag,
                # not the bare class, so it keys separately: two scenes sharing a
                # class stay unflagged once a slot disambiguates one side.
                slot = block.get("slot")
                key = f"{cls}:{slot}" if slot else cls
                owner = claimed_by.get(key)
                if owner and owner != name:
                    return refusal(
                        mode,
                        "class_conflict",
                        f"class '{cls}' claimed by {owner} and {name}",
                        **{"class": cls, "scenes": [owner, name]},
                    )
                claimed_by[key] = name

    # `main` (LEO-400): the scene this mode calls home. Optional (a
    # pre-LEO-400 declaration has none), but when present it must be one of
    # THIS mode's own admitted scenes -- naming one the mode does not list
    # would make the fallback itself unreachable.
    main = spec.get("main")
    if main is not None and main not in listed:
        return refusal(
            mode, "unknown_main", f"main '{main}' is not one of this mode's own scenes"
        )
    return None


def resolve(declaration: dict, mode: str) -> dict:
    base = declaration.get("base", {})
    spec = declaration.get("modes", {}).get(mode)
    if spec is None:
        known = ", ".join(sorted(declaration.get("modes", {})))
        sys.exit(f"unknown mode '{mode}' (known: {known})")
    refused = validate(declaration, mode)
    if refused:
        sys.exit(refused["reason"])

    placements = [{"name": p["name"], "monitor": p["monitor"]} for p in spec["scenes"]]
    desk = {
        "mode": mode,
        "hidden": spec.get("hidden") is True,
        "scenes": placements,
        "scene_specs": {p["name"]: base["scenes"][p["name"]] for p in placements},
        "workspaces": [p["name"] for p in placements],
    }
    # Mirrors Lua's `desk.main = spec.main`: a key present only when the mode
    # declares one, so a fixture predating LEO-400 (no `main` in `expected`)
    # still compares equal.
    if spec.get("main") is not None:
        desk["main"] = spec["main"]
    removed: dict[str, set[str]] = {}
    for kind in KINDS:
        desk[kind] = apply_delta(
            base.get(kind, []), spec.get(kind), f"mode '{mode}', {kind}"
        )
        # Only `remove` is an explicit refusal. `only` says what to inherit, so
        # the dependency closure may still widen it.
        removed[kind] = set((spec.get(kind) or {}).get("remove", []))

    close_deps(desk, base, mode, removed)

    for kind in KINDS:
        unknown = set(desk[kind]) - set(base.get(kind, []))
        if unknown:
            sys.exit(
                f"mode '{mode}': unknown {kind} {sorted(unknown)} — not declared in base"
            )

    desk["notify"] = {**base.get("notify", {}), **spec.get("notify", {})}
    desk["revoke"] = {**base.get("revoke", {}), **spec.get("revoke", {})}
    desk["presentation"] = dict(spec.get("presentation", {}))
    return desk


def revocation(desk: dict, kind: str, name: str) -> str:
    """How a resource is given up. Windows hold, background work retires.

    The two differ in how a resource is given up, not in whether it returns:
    what comes back is decided by the next desk.
    """
    declared = desk.get("revoke", {}).get(name)
    if declared:
        return declared
    return "hold" if kind in ("workspaces", "projects") else "retire"


def plan(desk: dict, running: dict) -> list[tuple[str, str, str]]:
    """Steps from the running desk to the desired one.

    Give up before taking on, so a transition never briefly runs both desks —
    on a machine being asked to reclaim resources that is the opposite of what
    was wanted. Revoke dependents first, admit dependencies first.
    """
    steps = []
    for kind in ("projects", "bindings", "services", "workspaces"):
        for name in running.get(kind, []):
            if name not in desk[kind]:
                steps.append((revocation(desk, kind, name), kind, name))
    for kind in ("workspaces", "services", "bindings", "projects"):
        for name in desk[kind]:
            if name not in running.get(kind, []):
                steps.append(("admit", kind, name))
    return steps


def seed(source: Path, force: bool) -> None:
    """Install a declaration into the store.

    The shell seeds its own stores from QML literals when a file is missing,
    but the declaration is read by the compositor too, and a desk that comes up
    before the shell does should not be waiting on it. This puts the file in
    place from either side.

    It refuses to overwrite by default: the store is edited at runtime, so a
    seed that clobbered it would throw away whatever was tuned by hand. The one
    exception is a version-keyed migration (LEO-337): a stored declaration
    whose `version` is lower than the one being seeded is stale by
    construction — nothing could have hand-tuned a field the shipped grammar
    didn't have yet — so it is replaced once, without `--force`. This is
    strictly one-way: equal or higher stored versions still require
    `--force`, so a hand-edited store at the current version is never
    silently clobbered.
    """
    target = state_dir() / "hyprfocus.json"
    reseed_reason = None
    if target.exists() and not force:
        try:
            stored = json.loads(target.read_text())
        except json.JSONDecodeError:
            stored = None
        try:
            shipped_version = json.loads(source.read_text()).get("version", 0)
        except (FileNotFoundError, json.JSONDecodeError):
            shipped_version = None
        stored_version = stored.get("version", 0) if isinstance(stored, dict) else None
        if (
            stored_version is not None
            and shipped_version is not None
            and stored_version < shipped_version
        ):
            reseed_reason = (
                f"stored version {stored_version} < shipped version {shipped_version}"
            )
        else:
            sys.exit(f"{target} already exists; pass --force to replace it")

    try:
        declaration = json.loads(source.read_text())
    except FileNotFoundError:
        sys.exit(f"no declaration at {source}")
    except json.JSONDecodeError as exc:
        sys.exit(f"{source}: {exc}")

    # Resolving every mode before writing: a declaration that cannot resolve is
    # one the desk would fail on at the next mode change, and failing here is
    # the cheaper place to find out.
    for mode in declaration.get("modes", {}):
        resolve(declaration, mode)

    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(declaration, indent=2) + "\n")
    if reseed_reason:
        print(f"reseeded {target} ({reseed_reason})")
    print(f"seeded {target} ({len(declaration.get('modes', {}))} modes)")


CONTRACT = Path(__file__).resolve().parent.parent / "etc" / "scene-managed.json"


def contract() -> dict:
    """The task-to-units map and the protected rail.

    The declaration names *tasks*; this says which units implement them. The
    split is deliberate: which services a mode runs is a preference edited
    live, what a task consists of is a system fact edited in unit files.
    """
    try:
        return json.loads(CONTRACT.read_text())
    except FileNotFoundError:
        sys.exit(f"no contract at {CONTRACT}")
    except json.JSONDecodeError as exc:
        sys.exit(f"{CONTRACT}: {exc}")


def units_for(tasks: dict, names: list[str]) -> tuple[set[str], list[str]]:
    """Units implementing these tasks, and any task nothing implements.

    An unmapped task is reported rather than ignored: it means the declaration
    and the unit files have drifted, and silently doing nothing is how that
    goes unnoticed until a mode stops working.
    """
    units: set[str] = set()
    unmapped = []
    for name in names:
        mapped = tasks.get(name)
        if mapped is None:
            unmapped.append(name)
        else:
            units.update(mapped)
    return units, unmapped


def systemctl(*args: str, check: bool = False) -> subprocess.CompletedProcess:
    binary = os.environ.get("SYSTEMCTL", "systemctl")
    return subprocess.run(
        [binary, "--user", *args], capture_output=True, text=True, check=check
    )


def unit_state(unit: str) -> tuple[str, str, str]:
    """(load, active, type) for a unit, in one query.

    Read rather than assumed, because the three cases behave differently and
    conflating them is how a transition reports noise instead of a problem.
    """
    result = systemctl(
        "show", "-p", "LoadState", "-p", "ActiveState", "-p", "Type", "--value", unit
    )
    lines = (result.stdout or "").splitlines()
    while len(lines) < 3:
        lines.append("")
    return lines[0].strip(), lines[1].strip(), lines[2].strip()


def is_active(state: str) -> bool:
    # `activating` counts: a oneshot part-way through its run is not something
    # to start again, and a service still coming up does not want restarting.
    return state in ("active", "activating", "reloading")


def log(entry: dict) -> None:
    """Append a decision. With a schedule able to change the mode on its own,
    "why did my desk do that" stops being a debugging question."""
    directory = state_dir() / "hyprfocus"
    directory.mkdir(parents=True, exist_ok=True)
    entry["at"] = datetime.now(timezone.utc).isoformat()
    with (directory / "log.jsonl").open("a") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")


def active(declaration: dict) -> dict:
    """The mode pointer, with whatever provenance it carries."""
    try:
        return read_store("focus.json")
    except (FileNotFoundError, json.JSONDecodeError):
        return {"mode": "work"}


def effective_mode(pointer: dict) -> str:
    """The mode actually in effect, resolving a timed mode's expiry.

    Pointer contract (shared with quickshell, hypr's Lua writer and the shell
    helpers): `mode` if `until` is unset or not yet passed; otherwise
    `previous` (the mode a timed mode was layered over) if the pointer
    carries one; otherwise `work`, the desk's resting mode. `neutral` is never
    a fallback — it stays a hidden recovery mode, reached only deliberately.
    """
    mode = pointer.get("mode") or "work"
    until = pointer.get("until")
    if until:
        try:
            expires = datetime.fromisoformat(until.replace("Z", "+00:00"))
            now = datetime.now(timezone.utc)
            if expires.tzinfo is None:
                expires = expires.replace(tzinfo=timezone.utc)
            if now > expires:
                return pointer.get("previous") or "work"
        except ValueError:
            pass  # malformed expiry: treat the mode as still live
    return mode


def lifecycle_log(trace: str | None, follow: bool) -> int:
    """Query the window lifecycle log (LEO-352).

    The sink is the systemd journal, not a file: `hypr/lib/trace.lua` writes
    one journal entry per decision, tagged `SYSLOG_IDENTIFIER=hyprfocus` and
    carrying the decision record's fields (`TRACE` is the window address).
    This just wraps the journalctl query the lifecycle contract names, so
    finding one window's whole lifecycle is one command rather than a
    hand-typed filter.
    """
    cmd = ["journalctl", "--user", "-t", "hyprfocus", "-o", "json"]
    if follow:
        cmd.append("-f")
    if trace:
        cmd.append(f"TRACE={trace}")
    return subprocess.run(cmd, check=False).returncode


def log_read(state: Path, count: int) -> int:
    """The recent decisions, one JSON row per line (LEO-241).

    The logging workspace is the answer to "what did the desk just do",
    readable with no compositor and no shell: this prints the last COUNT
    rows, bottom-first (the newest read is about the present). Missing rows
    read as an empty log, never an error — a fresh desk has made no
    decisions yet.
    """
    path = state / "scene-policy" / "log.jsonl"
    if not path.exists():
        return 0
    rows = path.read_text().splitlines()
    for line in rows[-count:] if count else rows:
        stripped = line.strip()
        if stripped:
            print(stripped)
    return 0


def conform(source: Path) -> int:
    """Run shared conformance fixtures against THIS resolver (LEO-287).

    The fixture shape is data: {name, declaration, mode, expected} — and
    `expected_error` carries SUBSTRING of the message (the two
    implementations may reach the same refusal in different words, which is
    fine; the desks may not differ). Exit 1 names every fixture that broke,
    so the composite gates fail closed.

    `source` names one fixture file or a directory of them.
    """
    files = (
        [source]
        if source.is_file()
        else sorted(p for p in source.iterdir() if p.suffix == ".json")
    )
    failed: list[str] = []
    for path in files:
        fixture = json.loads(path.read_text())
        name = fixture.get("name", path.name)
        want_error = fixture.get("expected_error")
        try:
            desk = resolve(fixture["declaration"], fixture["mode"])
        except SystemExit as exc:
            # `expected_error` covers a refusal by substring, so message
            # wording may drift without failing the conformance gate.
            if want_error and want_error in str(exc):
                print(f"ok     {name}")
            else:
                failed.append(f"{name}: refused {exc} (wanted error {want_error!r})")
            continue
        if want_error:
            failed.append(
                f"{name}: resolved, but the fixture expected error {want_error!r}"
            )
            continue
        if desk != fixture["expected"]:
            failed.append(
                f"{name}: desk disagrees with the fixture:\n{json.dumps(desk, indent=2)}"
            )
            continue
        print(f"ok     {name}")
    if failed:
        for f in failed:
            print(f"MISMATCH {f}", file=sys.stderr)
        return 1
    return 0


def print_desk(desk: dict) -> None:
    print(f"{'mode':<12}{desk['mode']}")
    for kind in ("workspaces", *KINDS):
        print(f"{kind:<12}{', '.join(desk[kind]) or '—'}")
    scenes = ", ".join(f"{p['name']}@{p['monitor']}" for p in desk["scenes"]) or "—"
    print(f"{'scenes':<12}{scenes}")
    routes = desk.get("notify", {})
    if routes:
        print(f"{'notify':<12}{json.dumps(routes, sort_keys=True)}")


def reapply_theme() -> None:
    """Re-run the accent-bearing theme adapters for the mode just entered.

    A mode's accent role can change on a transition even when the
    palette does not, so `,theme.sh apply` — which reads both off the same
    stores this converge just updated — has to run again here rather than
    waiting for the sun timer or a manual `set`. Best-effort and silent:
    a theme adapter failing must not fail a mode transition that otherwise
    succeeded, the same contract `apply_colors`'s pcall gives the compositor
    half. `HYPRFOCUS_NO_THEME` is the test escape hatch — tests exercise this
    module's own systemd bookkeeping and must not fan out into a real
    kitty/gsettings/hyprctl/awww call the way `,theme.sh` would.
    """
    if os.environ.get("HYPRFOCUS_NO_THEME"):
        return
    theme_sh = Path(__file__).resolve().parent / ",theme.sh"
    if not theme_sh.exists():
        return
    try:
        subprocess.run([str(theme_sh), "apply"], check=False, capture_output=True)
    except OSError:
        pass


def apply(declaration: dict, mode: str, dry_run: bool) -> int:
    """Bring background work in line with a mode.

    Three kinds of unit, which behave differently enough that conflating them
    reports noise instead of a problem:

    * **missing** — nothing installed it. Retrying will never succeed, so it is
      named once and skipped rather than attempted on every transition.
    * **oneshot** — an action, not a state. `systemctl start` on one means "run
      it now", which is its timer's job; admitting the task means making sure
      the timer runs. Stopping one is still meaningful: it cancels a run in
      flight.
    * **everything else** — started if the mode wants it and it is not already
      up, stopped if it does not.

    Stops go through systemctl, which is SIGTERM plus the unit's own
    TimeoutStopSec — never SIGKILL, and never a hand-rolled timeout racing
    systemd's own.
    """
    desk = resolve(declaration, mode)
    spec = contract()
    tasks = spec.get("tasks", {})
    protected = set(spec.get("protected", []))

    wanted, unmapped = units_for(tasks, desk["services"])
    known, _ = units_for(tasks, list(tasks))

    # The protected rail wins over any declaration. A store edited by hand
    # should not be able to stop the audio stack or the idle daemon.
    candidates = sorted((known | wanted) - protected)
    states = {unit: unit_state(unit) for unit in candidates}

    stop, start, missing, timers = [], [], [], []
    for unit in candidates:
        load, active, kind = states[unit]
        if load != "loaded":
            missing.append(unit)
        elif unit in wanted:
            if kind == "oneshot":
                timers.append(unit)
            elif not is_active(active):
                start.append(unit)
        elif is_active(active):
            stop.append(unit)

    if unmapped:
        print(
            f"warning: no units for {', '.join(unmapped)} — declaration and contract have drifted",
            file=sys.stderr,
        )
    if missing:
        print(f"warning: not installed: {', '.join(missing)}", file=sys.stderr)

    if dry_run:
        for unit in stop:
            print(f"  stop    {unit}")
        for unit in start:
            print(f"  start   {unit}")
        for unit in timers:
            print(f"  (timer) {unit}")
        if not stop and not start:
            print(f"already {mode}; nothing to do")
        return 0

    stopped, started, failed = [], [], []
    for unit in stop:
        result = systemctl("stop", unit)
        (stopped if result.returncode == 0 else failed).append(unit)
    for unit in start:
        result = systemctl("start", unit)
        (started if result.returncode == 0 else failed).append(unit)

    log(
        {
            "mode": mode,
            "stopped": stopped,
            "started": started,
            "failed": failed,
            "missing": missing,
            "unmapped": unmapped,
        }
    )

    for unit in stopped:
        print(f"  stopped {unit}")
    for unit in started:
        print(f"  started {unit}")
    for unit in failed:
        print(f"  FAILED  {unit}", file=sys.stderr)
    if not stopped and not started and not failed:
        print(f"already {mode}; nothing to do")

    reapply_theme()

    # A unit that would not move is reported, not fatal: one stubborn service
    # must not leave the desk wedged between two modes. Missing units are not a
    # failure of this run either — they are a packaging problem, and saying so
    # once is more useful than failing every transition until it is fixed.
    return 1 if failed else 0


def main() -> None:
    parser = argparse.ArgumentParser(
        prog=",hyprfocus", description=__doc__.split("\n")[0]
    )
    parser.add_argument(
        "--declaration", type=Path, help="declaration to read (default: the store)"
    )
    sub = parser.add_subparsers(dest="verb", required=True)
    sub.add_parser("modes", help="list every declared mode")
    seed_parser = sub.add_parser("seed", help="install a declaration into the store")
    seed_parser.add_argument("source", type=Path)
    seed_parser.add_argument(
        "--force", action="store_true", help="replace an existing store"
    )
    sub.add_parser("explain", help="which mode is on, who set it, and when")
    conform_parser = sub.add_parser(
        "conform", help="run shared resolver conformance fixtures"
    )
    conform_parser.add_argument("source", type=Path)
    log_parser = sub.add_parser(
        "log", help="print the scene-policy log's recent rows, or the lifecycle journal"
    )
    log_parser.add_argument(
        "count",
        nargs="?",
        type=int,
        default=20,
        help="scene-policy rows (ignored with --trace/--follow)",
    )
    log_parser.add_argument(
        "--trace",
        metavar="ADDRESS",
        help="filter the lifecycle journal by window address",
    )
    log_parser.add_argument(
        "--follow",
        action="store_true",
        help="follow the lifecycle journal instead of scene-policy",
    )
    for verb, help_text in (
        ("resolve", "the desk a mode means"),
        ("plan", "what would change"),
    ):
        p = sub.add_parser(verb, help=help_text)
        p.add_argument("mode")
    apply_parser = sub.add_parser(
        "apply", help="bring background work in line with a mode"
    )
    apply_parser.add_argument("mode")
    apply_parser.add_argument(
        "--dry-run", action="store_true", help="print the plan without acting"
    )

    args = parser.parse_args()

    # Seeding is the one verb that does not need a declaration already in place
    # — it is how one gets there.
    if args.verb == "seed":
        seed(args.source, args.force)
        return

    if args.verb == "conform":
        return conform(args.source)

    if args.verb == "log":
        if args.trace or args.follow:
            return lifecycle_log(args.trace, args.follow)
        return log_read(state_dir(), args.count)

    declaration = load(args.declaration)

    if args.verb == "modes":
        current = effective_mode(active(declaration))
        for name, spec in sorted(declaration.get("modes", {}).items()):
            # Hidden modes (neutral, the recovery fallback) are never a peer.
            if spec.get("hidden"):
                continue
            marker = "*" if name == current else " "
            print(f"{marker} {name:<10}{spec.get('name', '')}")
        return

    if args.verb == "explain":
        pointer = active(declaration)
        mode = pointer.get("mode", "work")
        print(f"{'mode':<10}{mode}")
        effective = effective_mode(pointer)
        if effective != mode:
            # A timed mode has expired; what is actually in effect fell back
            # to `previous` (or `work`), not to the stale pointer value.
            print(f"{'effective':<10}{effective}")
        # Provenance matters once a schedule can change the mode on its own:
        # "why did my desk just change" needs an answer that is not guesswork.
        print(f"{'set by':<10}{pointer.get('source', 'unknown')}")
        if pointer.get("set_at"):
            print(f"{'at':<10}{pointer['set_at']}")
        print(f"{'until':<10}{pointer.get('until') or 'open-ended'}")
        if pointer.get("previous"):
            print(f"{'previous':<10}{pointer['previous']}")
        # A declared unit that no converge has installed shows up as a
        # transition that quietly did less than it said (LEO-290): name the
        # absent units here too, so "why did that mode not do anything"
        # carries the reason. Best-effort: no systemctl means explain still
        # answers; a --declaration on a foreign tree reads only the store
        # contract beside this repo.
        result = subprocess.run(
            [str(Path(__file__).resolve().parent / ",hyprfocus-units"), "installed"],
            check=False,
            capture_output=True,
            text=True,
        )
        for line in result.stderr.splitlines():
            if line.startswith("not installed: "):
                print(f"missing  {line.split(': ', 1)[1]}")

        return

    if args.verb == "resolve":
        print_desk(resolve(declaration, args.mode))
        return

    if args.verb == "apply":
        sys.exit(apply(declaration, args.mode, args.dry_run))

    desired = resolve(declaration, args.mode)
    running = resolve(declaration, effective_mode(active(declaration)))
    steps = plan(desired, running)
    if not steps:
        print(f"already {args.mode}; nothing to do")
        return
    takes = [s for s in steps if s[0] in ("hold", "retire")]
    print(f"{len(steps)} steps, {len(takes)} take something away")
    for action, kind, name in steps:
        print(f"  {action:<7}{kind:<11}{name}")


if __name__ == "__main__":
    main()
