#!/usr/bin/env python3
""",hyprfocus-units — generate the capability targets, and gate the units.

A mode declares *capabilities*; `etc/scene-managed.json` says which units
implement each one. This turns that map into one systemd target per
capability, so a mode transition starts and stops a target rather than
enumerating units at runtime.

The targets are generated at provisioning time and committed. Generating them
from the compositor was rejected: the CLI has to work from a tmux pane with no
compositor running, `daemon-reload` is a side effect that races a transition in
flight, and a hand-fixed generated unit would be clobbered on the next reload.
So the generator writes files a human can read and CI can diff.

  ,hyprfocus-units generate   write etc/systemd/user/
  ,hyprfocus-units check      fail if what is committed is not what regenerates
  ,hyprfocus-units verify     fail if a declared unit has no owner, or two
  ,hyprfocus-units installed  ask the RUNNING user manager: every unit the
                              contract names must be installed, not just owned
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CONTRACT = REPO / "etc" / "scene-managed.json"
OUT_DIR = REPO / "etc" / "systemd" / "user"
PROGRAMME = REPO.parent

BANNER = "# Generated by ,hyprfocus-units from etc/scene-managed.json. Do not edit.\n"


def load(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        sys.exit(f"missing: {path}")
    except json.JSONDecodeError as exc:
        sys.exit(f"{path}: {exc}")


def target_name(capability: str) -> str:
    return f"hyprfocus-{capability}.target"


def render(capability: str, units: list[str]) -> str:
    """One capability's target.

    `Wants=` rather than `Requires=`: a capability whose indexer fails is a
    capability doing less, not a mode that failed to enter. Ordering is left to
    the units' own `After=` — the generator sequences nothing, because a
    generated ordering would silently disagree with a hand-written one.
    """
    lines = [BANNER, "[Unit]", f"Description=hyprfocus capability: {capability}"]
    if units:
        lines.append("Wants=" + " ".join(units))
    else:
        lines.append("# No units implement this capability.")
    return "\n".join(lines) + "\n"


def generated(contract: dict) -> dict[str, str]:
    tasks = contract.get("tasks", {})
    return {
        target_name(name): render(name, sorted(units))
        for name, units in sorted(tasks.items())
    }


def cmd_generate(_: argparse.Namespace) -> int:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    wanted = generated(load(CONTRACT))

    # Stale targets are removed, not left behind: a capability that was renamed
    # would otherwise keep a target nothing references but systemd still loads.
    for path in OUT_DIR.glob("hyprfocus-*.target"):
        if path.name not in wanted:
            path.unlink()
            print(f"removed {path.name}")

    for name, body in wanted.items():
        path = OUT_DIR / name
        if not path.exists() or path.read_text() != body:
            path.write_text(body)
            print(f"wrote {name}")
    return 0


def cmd_check(_: argparse.Namespace) -> int:
    wanted = generated(load(CONTRACT))
    on_disk = {p.name: p.read_text() for p in OUT_DIR.glob("hyprfocus-*.target")}
    problems = [f"not generated: {n}" for n in sorted(set(on_disk) - set(wanted))]
    problems += [f"missing: {n}" for n in sorted(set(wanted) - set(on_disk))]
    problems += [
        f"stale: {n}"
        for n in sorted(set(wanted) & set(on_disk))
        if on_disk[n] != wanted[n]
    ]
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        print("run ,hyprfocus-units generate and commit the result", file=sys.stderr)
        return 1
    print(f"{len(wanted)} targets up to date")
    return 0


def provisioned(programme: Path) -> dict[str, list[str]]:
    """Unit name -> the places in the programme that install it.

    A unit with no entry is one that exists on whichever machine it was first
    written on and nowhere else — it does not survive a rebuild, and a mode
    that names it half-runs. A unit with two entries is worse: whichever
    mechanism ran last decides the unit's contents.
    """
    owners: dict[str, list[str]] = {}
    roles = programme / "system-config" / "roles"
    for path in roles.glob("*/templates/*.j2"):
        owners.setdefault(path.name[:-3], []).append(str(path.relative_to(programme)))
    for path in roles.glob("*/files/*"):
        if path.suffix in (".service", ".timer", ".target"):
            owners.setdefault(path.name, []).append(str(path.relative_to(programme)))
    for path in (programme / "scripts" / "etc" / "systemd" / "user").glob("*"):
        owners.setdefault(path.name, []).append(str(path.relative_to(programme)))
    return owners


def declared_units(contract: dict) -> set[str]:
    units = set(contract.get("protected", []))
    for task_units in contract.get("tasks", {}).values():
        units.update(task_units)
    for scene in contract.get("scenes", {}).values():
        units.update(u for u in scene.get("stop", []) if re.search(r"\.\w+$", u))
    return units


def cmd_verify(args: argparse.Namespace) -> int:
    programme = Path(args.programme).resolve()
    contract = load(CONTRACT)
    owners = provisioned(programme)
    packaged = {p.name for p in Path("/usr/lib/systemd/user").glob("*")}

    orphans, doubled = [], []
    for unit in sorted(declared_units(contract)):
        found = owners.get(unit, [])
        if len(found) > 1:
            doubled.append(f"{unit}: owned by {', '.join(found)}")
        elif not found and unit not in packaged:
            orphans.append(unit)

    for unit in orphans:
        print(f"no owner: {unit}", file=sys.stderr)
    for line in doubled:
        print(f"two owners: {line}", file=sys.stderr)
    if orphans or doubled:
        return 1
    print(f"{len(declared_units(contract))} declared units, one owner each")
    return 0


def cmd_installed(args: argparse.Namespace) -> int:
    """Ask the running user manager whether the declared units exist.

    `verify` reads a checkout and can run anywhere (it is the CI-safe half);
    this needs the machine it is judging, so it runs at the END of a converge
    — where a missing unit means the run that was supposed to install it did
    not — and from `,hyprfocus explain`, so "why did that mode not do
    anything" names the absent unit instead of surfacing as a transition
    that quietly did less than it said (LEO-290).

    `LoadState=not-found` is the missing case. `masked` is a refusal the
    machine made deliberately and is reported rather than failed, so the
    rail the protected list builds is visible here too.
    """
    import subprocess

    contract = load(CONTRACT)
    unit_states: dict[str, str] = {}
    for unit in sorted(declared_units(contract)):
        proc = subprocess.run(
            ["systemctl", "--user", "show", "-p", "LoadState", "--value", unit],
            check=False,
            capture_output=True,
            text=True,
        )
        unit_states[unit] = proc.stdout.strip() or "unknown"

    missing = [(u, s) for u, s in sorted(unit_states.items()) if s == "not-found"]
    unknown = [(u, s) for u, s in sorted(unit_states.items()) if s in ("unknown",)]
    for unit, state in missing:
        print(f"not installed: {unit}", file=sys.stderr)
    for unit, state in unknown:
        print(f"unknown state ({state}): {unit}", file=sys.stderr)
    if missing:
        # Named at converge and in explain, rather than silently less.
        return 1
    print(f"{len(unit_states)} declared units installed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("generate").set_defaults(run=cmd_generate)
    sub.add_parser("check").set_defaults(run=cmd_check)
    verify = sub.add_parser("verify")
    verify.add_argument("--programme", default=str(PROGRAMME))
    verify.set_defaults(run=cmd_verify)
    installed = sub.add_parser(
        "installed", help="declared units exist in the RUNNING user manager"
    )
    installed.set_defaults(run=cmd_installed)
    args = parser.parse_args()
    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
